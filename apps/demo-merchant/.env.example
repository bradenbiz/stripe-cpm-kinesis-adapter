# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys).
# Copy this file to .env.local — .env.local is gitignored.

STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Stripe Custom Payment Method type id for Kinesis Pay.
# Create one at https://dashboard.stripe.com/test/settings/custom_payment_methods
# Leave blank to fall back to card-only checkout.
KINESIS_CPMT_ID=

# Base URL of the locally-running adapter Worker (wrangler dev defaults to 8787).
# The CheckoutForm builds the Stripe `return_url` from this so Stripe redirects
# the customer to the adapter for the QR/approval flow when "Pay with Gold" is
# selected. Must be reachable from the customer's browser.
NEXT_PUBLIC_ADAPTER_BASE_URL=http://localhost:8787
