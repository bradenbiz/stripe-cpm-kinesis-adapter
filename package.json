{
  "name": "stripe-cpm-kinesis-adapter",
  "version": "0.0.0",
  "description": "Stripe Custom Payment Method adapter for Kinesis Pay.",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:adapter": "npm run dev --workspace=apps/adapter",
    "dev:merchant": "npm run dev --workspace=apps/demo-merchant",
    "test": "npm test --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
